{
  "name": "@dsh-gis/dsh-video-studio-skill",
  "version": "0.7.2",
  "description": "Video Studio skill plugin for DeepSeek Harness: style-pack driven code-generated Chinese videos — one style id decides palette/typography/music style/voice persona/pacing, measured TTS timeline, deterministic PIL/browser rendering, programmatic SFX and score, cue-driven sound sync, ffmpeg encoding, sample-level mixing and multi-layer QA gates.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/demo-pil-sheet.png",
    "THIRD_PARTY_NOTICES.md",
    "skills",
    "!skills/**/__pycache__",
    "!skills/**/*.pyc",
    "docs/styles/sheet-8-styles.png",
    "docs/styles/sheet-ai.png",
    "docs/styles/sheet-craft.png",
    "docs/styles/sheet-night.png",
    "docs/styles/demo-results.json",
    "schemas",
    "tools/estimate.py",
    "tools/ci_check.py",
    "tools/audio_similarity.py",
    "tools/selftest_noscipy.py"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/znlgis/dsh-video-studio-skill#readme",
  "bugs": {
    "url": "https://github.com/znlgis/dsh-video-studio-skill/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "video",
    "ffmpeg",
    "edge-tts",
    "playwright",
    "sfx",
    "score",
    "字幕",
    "视频",
    "配音"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znlgis/dsh-video-studio-skill.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "license": "MIT"
}
